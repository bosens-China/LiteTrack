{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error"
  },
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": ["apps/server/**", "apps/sdk/scripts/**", "apps/sdk/tests/**"],
      "env": {
        "browser": false,
        "node": true
      }
    },
    {
      "files": ["apps/server/test/browser.mts"],
      "env": {
        "browser": true
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "apps/admin/public/sdk/**"
  ]
}
