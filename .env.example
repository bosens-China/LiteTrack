# 生产 Compose；使用 openssl rand -hex 32 分别生成两项随机值。
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-another-random-hex-value
PUBLIC_URL=https://analytics.example.com
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
HTTP_PORT=8080
# 部署 CI 产物时，将两项都设置为同一个 Git SHA 的镜像标签。
# SERVER_IMAGE=boses/litetrack-server:SHA
# ADMIN_IMAGE=boses/litetrack-admin:SHA
