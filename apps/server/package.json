{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "LiteTrack Hono API",
  "main": "dist/app.js",
  "files": [
    "dist",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "build": "tsc",
    "build:ts": "tsc",
    "start": "node dist/app.js",
    "dev": "tsx watch src/app.ts",
    "test": "vitest run",
    "test:browser": "tsx test/browser.mts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "lint": "oxlint --deny-warnings -c ../../.oxlintrc.json src test",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@litetrack/contracts": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^17.3.1",
    "hono": "^4.13.13",
    "ioredis": "^5.10.0",
    "jose": "^6.2.12",
    "pg": "^8.20.0",
    "pino": "^10.4.0",
    "prisma": "^7.10.0",
    "proxy-addr": "^2.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.0.8",
    "@types/pg": "^8.18.0",
    "@types/proxy-addr": "^2.0.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
