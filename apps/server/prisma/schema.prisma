generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id Int @id @default(autoincrement())
  githubId String @unique
  username String
  avatar String?
  sites Site[]
}
model Site {
  id Int @id @default(autoincrement())
  userId Int
  domain String
  title String
  description String @default("")
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokens SiteToken[]
  visitors Visitor[]
  sessions Session[]
  events PageviewEvent[]
  @@unique([userId, domain])
}
model SiteToken {
  id Int @id @default(autoincrement())
  siteId Int
  token String @unique
  name String
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
}
model Visitor {
  id Int @id @default(autoincrement())
  siteId Int
  visitorId String
  currentSessionId String?
  lastSeenAt DateTime @db.Timestamptz(3)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@unique([siteId, visitorId])
}
model Session {
  id String @id
  siteId Int
  visitorId String
  startedAt DateTime @db.Timestamptz(3)
  lastSeenAt DateTime @db.Timestamptz(3)
  entryPath String
  referrerDomain String
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  events PageviewEvent[]
  @@unique([siteId, id])
  @@index([siteId, startedAt])
}
model PageviewEvent {
  id Int @id @default(autoincrement())
  siteId Int
  eventId String
  visitorId String
  sessionId String
  path String
  title String?
  receivedAt DateTime @db.Timestamptz(3)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [siteId, sessionId], references: [siteId, id], onDelete: Cascade)
  @@unique([siteId, eventId])
  @@index([siteId, receivedAt])
  @@index([siteId, path, receivedAt])
}
