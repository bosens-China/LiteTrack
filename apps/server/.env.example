# Database
DATABASE_URL="postgresql://litetrack:litetrack_password@localhost:25432/litetrack"

# Redis
REDIS_URL="redis://localhost:26379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# GitHub OAuth
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:8080/auth/callback"
APP_TIMEZONE="Asia/Shanghai"

# Server
PORT=3000
HOST=0.0.0.0

# 直连为 false；反代部署填写可信代理 IP/CIDR，不能使用数字跳数。
TRUST_PROXY=false

# 公共采集接口每分钟的 IP 总量 / 站点写入总量（与路径、visitorId 无关）
TRACK_IP_RATE_LIMIT=300
TRACK_SITE_RATE_LIMIT=6000
