{
  "name": "@boses/litetrack-sdk",
  "version": "1.1.1",
  "description": "LiteTrack analytics SDK - lightweight and framework-agnostic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bosens-China/LiteTrack.git",
    "directory": "apps/sdk"
  },
  "homepage": "https://github.com/bosens-China/LiteTrack/tree/master/apps/sdk#readme",
  "bugs": {
    "url": "https://github.com/bosens-China/LiteTrack/issues"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings -c ../../.oxlintrc.json src tests scripts",
    "test": "vitest run",
    "publish-sdk": "node scripts/publish.mjs",
    "check-package": "node scripts/check-package.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsdown": "^0.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18",
    "@litetrack/contracts": "workspace:*"
  },
  "keywords": [
    "analytics",
    "tracking",
    "pageviews",
    "statistics",
    "sdk"
  ],
  "license": "MIT"
}
